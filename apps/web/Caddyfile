# Reference: https://docs.railway.com/guides/react#use-a-dockerfile
# global options
{
    admin off # there's no need for the admin api in railway's environment
    persist_config off # storage isn't persistent anyway
    auto_https off # railway handles https for us, this would cause issues if left enabled
    # runtime logs
    log {
        format json # set runtime log format to json mode
    }
    # server options
    servers {
        trusted_proxies static private_ranges 100.0.0.0/8 # trust railway's proxy
    }
}

# site block, listens on the $PORT environment variable, automatically assigned by railway
:{$PORT:3000} {
    # access logs
    log {
        format json # set access log format to json mode
    }

    # health check for railway
    rewrite /health /*

    # Proxy the API through this origin.
    #
    # The browser must talk to exactly one origin. Served from two, the session
    # cookie is cross-site - `up.railway.app` is a public suffix, so sibling
    # subdomains are different *sites*, not merely different hosts - and a
    # cross-site cookie is a third-party cookie, which Safari blocks outright
    # and Chrome and Firefox increasingly do. Sign-in then returns 200, the
    # browser discards the session, and the application looks signed out with
    # nothing on screen to say why.
    #
    # Routing through here also makes SERVER_URL and BETTER_AUTH_URL the same
    # origin, which flips the cookie back to SameSite=Lax and takes the whole
    # question off the table.
    #
    # The API's paths are enumerated rather than matched by prefix: the
    # interface has its own client-side routes under /recruitment/<cycleId>/...
    # and a catch-all would swallow them. Every API resource here is a fixed
    # word where a cycle id would otherwise be. One `path` directive, because
    # repeating a matcher type ANDs it and no request is under all of them.
    # Both the bare path and the sub-tree: in Caddy `/recruitment/cycles/*`
    # does not match `/recruitment/cycles` itself, which is the collection the
    # interface lists cycles from.
    @api path /api/* /auth/* /admin/* /recruitment/cycles /recruitment/cycles/* /recruitment/applications/* /recruitment/assignments/* /recruitment/candidacies/* /recruitment/imports/* /recruitment/memberships/*

    # `handle` blocks rather than bare directives: Caddy runs `try_files` (a
    # rewrite) before `reverse_proxy`, so without this every API path is
    # rewritten to /index.html and answered with the SPA shell before the
    # proxy ever sees it. `handle` blocks are mutually exclusive and run in
    # the order written.
    handle @api {
        reverse_proxy {$API_ORIGIN} {
            header_up Host {upstream_hostport}
        }
    }

    # Build output, served without the SPA fallback.
    #
    # `try_files` sends anything it cannot find to index.html, which for a
    # missing asset means answering a JavaScript request with HTML, and a 200
    # at that. The browser then fails to parse the module and renders nothing -
    # a blank page with no error that names the cause.
    #
    # That is not hypothetical: a browser holding an index.html from before a
    # deploy asks for the previous build's hashed bundle, which no longer
    # exists. Letting it 404 honestly means the reload that follows fixes it.
    #
    # Vite hashes these filenames, so the contents behind one can never change
    # and a year is safe.
    handle /assets/* {
        root * dist
        encode gzip
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        # serve from the 'dist' folder (Vite builds into the 'dist' folder)
        root * dist

        # enable gzipping responses
        encode gzip

        # index.html names the hashed bundles, so a stale copy points at files
        # that a deploy has already removed. Revalidating every time is what
        # keeps a returning visitor from loading yesterday's shell against
        # today's assets.
        header Cache-Control "no-cache"

        # if path doesn't exist, redirect it to 'index.html' for client side routing
        try_files {path} /index.html

        # serve files from 'dist'
        file_server
    }
}
