# Local development without ScottyLabs OpenBao access.
#
# Copy to `.env.local` (gitignored) and run the `:local` scripts, which load it
# with dotenv-cli instead of resolving secrets through secretspec:
#
#   bun run dev:local
#
# Real sign-in still needs Keycloak. To work without it, create a local session
# with `bun run dev:login <andrewId> --admin`. See docs/local-development.md.

# --- Database -----------------------------------------------------------------
# Matches .devcontainer/docker-compose.yml.
DATABASE_URL=postgresql://postgres:donotuseinprod@localhost:5432/labrador-recruit

# --- Better Auth --------------------------------------------------------------
# Signs the session cookie. Any long random string works locally; generate one
# with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# --- Server -------------------------------------------------------------------
SERVER_URL=http://localhost:8080
SERVER_PORT=8080
ALLOWED_ORIGINS_REGEX=^https?://localhost:3000$

# Membership in this Keycloak group grants the global admin role. Locally it is
# whatever `dev:login --admin` writes into the token.
ADMIN_GROUP=labrador-recruit-admins

# --- Keycloak -----------------------------------------------------------------
# Placeholders. Nothing contacts these while you sign in with `dev:login`; they
# exist because the server validates its environment on boot. Replace them with
# the real values from Goldador when you move to actual OIDC sign-in.
AUTH_ISSUER=https://auth.example.com
AUTH_CLIENT_ID=local-client
AUTH_CLIENT_SECRET=local-secret
AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json

# Goldador groups allowed to sign in, comma-separated. `infra/keycloak/teams.tf`
# names the team group after the team slug and the admin group `<slug>-admins`,
# and emits both in a `groups` claim. Anyone whose CMU login carries none of
# these is refused: the realm brokers straight to CMU SAML, so without this
# every Andrew ID at the university could sign in. ADMIN_GROUP is always
# allowed as well, so a mistyped list cannot lock an administrator out.
AUTH_ALLOWED_GROUPS=labrador-recruit

# auto | on | off. "auto" means Andrew ID and password work only while
# AUTH_CLIENT_ID is still the placeholder, so single sign-on replaces password
# accounts rather than sitting alongside them as a way around the group gate.
PASSWORD_SIGN_IN=auto

# --- Web ----------------------------------------------------------------------
VITE_SERVER_URL=http://localhost:8080
