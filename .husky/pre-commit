#!/usr/bin/env sh
# POSIX sh rather than zsh so the hook runs on Windows (Git Bash) as well as
# macOS and Linux. CI (.github/workflows/check.yml) remains the authoritative
# gate; this runs everything it does except the end-to-end suite, which is too
# slow to justify on every commit.
set -e

# Pinned to v6: v7 fails at startup on this runtime with
# "setGlobalProxyFromEnv is not a function".
bunx editorconfig-checker --exclude '(^LICENSE|^packages/db/drizzle/.*$)'

bun run syncpack
bunx markdownlint-cli2
bun run quality
bun run test
